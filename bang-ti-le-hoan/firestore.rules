rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Admin hợp lệ khi:
    // 1) có custom claim admin=true; HOẶC
    // 2) có document admins/{Firebase Auth UID}.
    //
    // Không tự cấp admin theo email/password để tránh một tài khoản password bất kỳ
    // có thể tự trở thành quản trị.
    function isAdmin() {
      return signedIn()
        && (
          request.auth.token.admin == true
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    function ownsDashboard(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Tạo admins/{UID_ADMIN} từ Firebase Console hoặc dùng custom claim admin=true.
    // Admin chỉ cần đọc document UID của chính mình để xác minh quyền.
    match /admins/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    // Pancake API config chỉ Admin được tạo/sửa/xóa.
    // User Google chỉ đọc đúng cấu hình theo UID của chính mình để GitHub Pages
    // có thể đồng bộ Pancake mà không hiển thị phần cài đặt.
    match /pancakeConfigs/{userId} {
      allow get: if isAdmin() || ownsDashboard(userId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Mỗi tài khoản Google chỉ đọc/ghi document có ID = Firebase Auth UID của mình.
    // Admin chỉ đọc/list để theo dõi realtime.
    match /orderDashboards/{userId} {
      allow get: if isAdmin() || ownsDashboard(userId);
      allow list: if isAdmin();

      allow create: if ownsDashboard(userId)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.authProvider == 'google.com';

      // FIX PERMISSION / LEGACY MIGRATION:
      // Bản cũ có thể đã tạo document orderDashboards/{UID} trước khi có ownerUid.
      // Chỉ cần path UID đúng tài khoản là đủ để cho phép tài khoản đó tự migrate.
      // Dữ liệu SAU update vẫn bắt buộc ownerUid = UID và authProvider = google.com.
      allow update: if ownsDashboard(userId)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.authProvider == 'google.com';

      allow delete: if false;
    }
  }
}
